<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SeaPowerUX.Core</AssemblyName>
    <Version>0.5.0</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <RootNamespace>SeaPowerUX.Core</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!--
      This is NOT a BepInEx plugin (no [BepInPlugin] anywhere in this assembly) — it's a shared
      dependency library referenced by every SeaPowerUX.* panel plugin. It deploys to its own
      single folder (BepInEx/plugins/SeaPowerUX.Core/) so there is exactly one loaded copy and
      one shared static state (XAML overrides, the shared overlay Canvas) across every plugin
      that references it. Build this project first — dependent plugins' HintPath references
      resolve against the deployed copy, not a project reference.

      Path to the Sea Power install directory. Override on the command line, e.g.:
        dotnet build -p:GameDir="C:\Program Files (x86)\Steam\steamapps\common\Sea Power"
      or set it permanently via the SEA_POWER_GAME_DIR environment variable.
    -->
    <GameDir Condition="'$(GameDir)' == '' AND '$(SEA_POWER_GAME_DIR)' != ''">$(SEA_POWER_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sea Power</GameDir>

    <ManagedDir>$(GameDir)\Sea Power_Data\Managed</ManagedDir>
    <BepInExCoreDir>$(GameDir)\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UniRx">
      <HintPath>$(ManagedDir)\UniRx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Seapower-Scripts">
      <HintPath>$(ManagedDir)\Seapower-Scripts.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Noesis.NoesisGUI">
      <HintPath>$(ManagedDir)\Noesis.NoesisGUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Deploy to its own dedicated, non-plugin folder that every SeaPowerUX.* plugin references. -->
  <Target Name="CopyToPluginsDir" AfterTargets="Build" Condition="Exists('$(GameDir)')">
    <MakeDir Directories="$(GameDir)\BepInEx\plugins\SeaPowerUX.Core" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(GameDir)\BepInEx\plugins\SeaPowerUX.Core\" />
  </Target>

</Project>
